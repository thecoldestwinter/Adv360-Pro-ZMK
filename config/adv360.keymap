#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LG(SPACE)     &kp N1    &kp N2    &kp N3        &kp N4     &kp N5  &none                                                                     &mo 6           &kp N6  &kp N7    &kp N8         &kp N9         &kp N0     &mt LG(L) LA(LC(DEL))
&kp MINUS         &kp B     &kp L     &kp D         &kp C      &kp V   &none                                                                     &none           &kp J   &kp Y     &kp O          &kp U          &kp COMMA  &kp SLASH
&kp LEFT_CONTROL  &kp N     &kp R     &kp T         &kp S      &kp G   &none      &kp RIGHT_ALT  &kp TAB               &caps_word    &kp DELETE  &none           &kp P   &kp H     &kp A          &kp E          &kp I      &kp RIGHT_CONTROL
&kp LEFT_ALT      &kp X     &kp Q     &kp M         &kp W      &kp B                             &kp LEFT_WIN          &kp CAPSLOCK                              &kp K   &kp F     &kp SQT        &kp BACKSPACE  &kp DOT    &kp LEFT_ALT
&mo 5             &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT          &kp SPACE  &kp ENTER      &kp LC(LEFT_ALT)      &kp ESC       &mo 3       &kp LEFT_SHIFT          &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP    &kp END    &mo 4
            >;
        };

        gallium_ger {
            display-name = "Base";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                      &trans  &kp N6  &kp N7  &kp N8   &kp N9         &kp N0     &trans
&trans  &kp B   &kp L   &kp D   &kp C   &kp V   &trans                                      &trans  &kp J   &kp Z   &kp O    &kp U          &kp COMMA  &trans
&trans  &kp N   &kp R   &kp S   &kp T   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp P   &kp H   &kp E    &kp I          &kp A      &trans
&trans  &kp X   &kp Q   &kp M   &kp W   &kp Y                   &trans      &trans                  &kp K   &kp F   &kp SQT  &kp BACKSPACE  &kp DOT    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans   &trans         &trans     &trans
            >;
        };

        qwerty {
            display-name = "Base";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                      &trans  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0         &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                      &trans  &kp Y   &kp U   &kp I      &kp O    &kp P          &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp J   &kp K      &kp L    &kp SEMI       &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                   &trans      &trans                  &kp N   &kp M   &kp COMMA  &kp DOT  &kp BACKSPACE  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans     &trans   &trans         &trans
            >;
        };

        symbols {
            bindings = <
&none   &trans       &trans         &trans            &trans      &trans         &none                                       &none   &trans           &trans                 &trans                &trans             &trans     &none
&trans  &kp PERCENT  &kp LESS_THAN  &kp GREATER_THAN  &kp DOLLAR  &kp AT         &none                                       &none   &kp AMPERSAND    &kp RIGHT_BRACKET      &kp LEFT_BRACKET      &kp HASH           &kp COMMA  &trans
&trans  &kp EXCL     &kp MINUS      &kp PLUS          &kp EQUAL   &kp QUESTION   &none   &trans  &trans      &trans  &trans  &none   &kp PIPE         &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp COLON          &kp SEMI   &trans
&trans  &kp CARET    &kp SLASH      &kp ASTERISK      &kp UNDER   &kp BACKSLASH                  &trans      &trans                  &kp RIGHT_BRACE  &kp LEFT_BRACE         &kp SQT               &kp DOUBLE_QUOTES  &kp DOT    &trans
&trans  &trans       &trans         &trans            &trans                     &trans  &trans  &trans      &trans  &trans  &trans                   &trans                 &kp GRAVE             &kp TILDE          &trans     &trans
            >;
        };

        function {
            bindings = <
&none   &none            &none    &none    &none    &none       &none                                       &none   &none  &none  &none  &none  &none  &none
&trans  &kp PAUSE_BREAK  &kp F12  &kp F11  &kp F10  &none       &none                                       &none   &none  &none  &none  &none  &none  &trans
&trans  &kp SCROLLLOCK   &kp F9   &kp F8   &kp F7   &kp ESCAPE  &none   &trans  &trans      &trans  &trans  &none   &none  &none  &none  &none  &none  &trans
&trans  &kp PRINTSCREEN  &kp F6   &kp F5   &kp F4   &kp INS                     &trans      &trans                  &none  &none  &none  &none  &none  &trans
&trans  &none            &kp F3   &kp F2   &kp F1               &trans  &trans  &trans      &trans  &trans  &trans         &none  &none  &none  &none  &trans
            >;
        };

        other {
            bindings = <
&trans  &none                 &none                 &none                 &none                 &none  &none                                                 &none   &none  &kp KP_NUMLOCK   &kp KP_SLASH     &kp KP_MULTIPLY  &kp KP_SUBTRACT  &trans
&trans  &none                 &none                 &kp C_REWIND          &kp C_FAST_FORWARD    &none  &none                                                 &none   &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL     &trans
&trans  &none                 &none                 &kp C_PREV            &kp C_NEXT            &none  &none   &trans  &trans      &trans        &kp C_MUTE  &none   &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &trans
&trans  &kp LG(LC(NUMBER_4))  &kp LC(LG(NUMBER_3))  &kp LC(LG(NUMBER_2))  &kp LC(LG(NUMBER_1))  &none                  &trans      &kp C_VOL_UP                      &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &trans
&trans  &none                 &none                 &none                 &none                        &trans  &trans  &trans      &kp C_VOL_DN  &kp C_PP    &trans         &kp KP_NUMBER_0  &kp KP_COMMA     &kp KP_DOT       &none            &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
